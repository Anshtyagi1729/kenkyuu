# All of these are free-tier keys. Leave any blank and the LLM router will
# skip that provider and fall through to the next one.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional - raises Semantic Scholar's unauthenticated rate limit if set.
S2_API_KEY=

# Local storage paths (defaults are fine for dev).
CHROMA_DIR=./data/chroma
SQLITE_PATH=./data/papers.db
CACHE_DIR=./data/cache

# Optional model overrides - defaults in app/config.py are current as of
# 2026-08-31. Only set these if a default model gets deprecated.
# GROQ_MODEL_CHEAP=openai/gpt-oss-20b
# GROQ_MODEL_STRONG=openai/gpt-oss-120b
# GEMINI_MODEL_CHEAP=gemini-flash-lite-latest
# GEMINI_MODEL_STRONG=gemini-flash-latest

# OpenRouter's free-model pool rotates - no safe default. Pick two current
# free, tool-calling-capable models from https://openrouter.ai/models?max_price=0
# if you want OpenRouter as a third fallback; leave blank to skip it (Groq +
# Gemini alone are enough to get started).
OPENROUTER_MODEL_CHEAP=
OPENROUTER_MODEL_STRONG=
